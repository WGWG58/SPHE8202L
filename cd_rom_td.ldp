        *preview.o  (.text*)
        *cdg.o      (.rodata*)
        *cdg.o      (.text*)        
        *navif.o    (.text*)
        *book.o     (.text*)
        
        *supdec*.o   (.text*)
//        *slowback.o (.text*)
        *cdfunc.o   (.text*)    
        *dvdpe.o    (.text*)        
        
       // *repeat.o   (.text*)
                
    //kevinmonkey 06094 kick these out since code grows too large
        //*psd.o      (.rodata*)

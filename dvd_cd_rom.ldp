    .drv_cdrom :
    {
        _text_drv_cdrom = .;
    #ifndef UNLOAD_ROMCODE

		#ifndef DVD_ESP_2S	//linrc for play CD system reset when define ESP_2S 2006-2-21 11:12
        *fsCDDA.o   (.rodata*)//nono 4-9-1 12:01 move from sdram_drv1
        *fsCDDA.o   (.text*)
        #endif

        #ifndef SUPPORT_MP4_SUBTITLE
        *fsNAV.o       (.text*)
        *fs_nav_upgrade.o      (.text*)
        *fs_nav_upgrade.o      (.rodata*)        
        #endif  //#ifndef SUPPORT_MP4_SUBTITLE

        #ifdef LOAD_CDROM
        *ThumbNav.o    (.rodata*)
        *ThumbNav.o    (.text*)
        *fsNAV.o       (.rodata*)

    #ifndef JPG_OLD_PARSER_FLOW        
        *pic_effect.o   (.rodata*)
        *pic_effect.o   (.text*)
    #endif        
        
            #ifndef PMP_DVD
        *fsGUI.o       (.text*)     //fsgui_pub.c
        *fsGUI.o       (.rodata*)
            #endif  //#ifndef PMP_DVD
 
        *udf.o         (.text*)
        *udf.o         (.rodata*)
        *fs9660.o      (.text*)
        *fs9660.o      (.rodata*)
    #ifndef SDRAM_16Mb_Mode    //kevinmonkey 060601 put this in CDROM section would cause VCD game to halt.
        *NESInit.o     (.text*)
    #endif
        //*nesif.o       (.text*)
        //*nesif.o       (.rodata*)
            #if defined(SDRAM_16Mb_Mode)&&defined(SUPPORT_MP4)
        ;//srv_cardfile is in fsfile.c, 16m mp4 will destroy CDROM code
         //so either move srv_cardfile out of fsfile.c of not load fsfile.o to SDRAM
            #else   //not 16m or 16m without avi
        *fsFile.o      (.rodata*)
        *fsFile.o      (.text*)
            #endif  //decide if we load fsFile.o
        *fsGUIX.o      (.text*)

            #ifdef LOAD_AP
                //nono 2004-10-10 13:20 move here from "drv_ap1".
                #if !defined(BBK_DVD)&&!defined(NINTAUS_DVD)||defined(NIN_612_4M)  //terry,2003/12/17 06:18PM      
       *graph.o        (.rodata*)
       *graph.o        (.text*)
                    #ifndef DIP_CFG_ENABLE      // 2005/03/02 yltseng
       *atapi_if.o     (.text*)
       //*atapi_.o       (.text*)
                    #endif  //#ifndef DIP_CFG_ENABLE      // 2005/03/02 yltseng
                    #if defined(LOAD_AP_OTHER)&&!defined(DVD_AUDIO)&&!defined(DVD_ESP_2S)//nono 2004-10-16 16:23
        *cderr.o    (.text*) //kevinmonkey 050323 moved here since this conflicts with DIP_CFG_ENABLE as well
                    #endif//#if defined(LOAD_AP_OTHER)&&!defined(DVD_AUDIO)&&!defined(DVD_ESP_2S)
                #endif  // #if !defined(BBK_DVD)&&!defined(NINTAUS_DVD)||defined(NIN_612_4M)
            #endif//#ifdef LOAD_AP
        #endif  //#ifdef LOAD_CDROM

    #endif  //#ifndef UNLOAD_ROMCODE
        .       = ALIGN(16);
    } > sdram_cdrom


